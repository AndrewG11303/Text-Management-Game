<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="MainMenu.CharacterCreationController"
      fx:id="rootPane"
      spacing="100">

    <!-- overall padding -->
    <padding>
        <Insets top="20" right="50" bottom="20" left="20"/>
    </padding>

    <!-- ——— MULTIPLAYER SUMMARY PANE ——— -->
    <VBox fx:id="summaryPane"
          spacing="10"
          alignment="TOP_LEFT">
        <Label text="Players Created:"
               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <ListView fx:id="summaryList"
                  prefWidth="250"
                  prefHeight="500"
                  style="-fx-font-size: 16px;"/>
    </VBox>

    <!-- ——— FORM WRAPPED IN SCROLLPANE ——— -->
    <ScrollPane fitToWidth="true"
                prefWidth="700"
                prefHeight="600"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">
        <content>
            <VBox fx:id="formPane"
                  alignment="TOP_CENTER"
                  spacing="30">

                <!-- header -->
                <Label fx:id="headerLabel"
                       text="Create Player 1"
                       style="-fx-font-size: 48px;"/>

                <!-- Name field -->
                <Label text="Name:"
                       style="-fx-font-size: 24px;"/>
                <ComboBox fx:id="nameField"
                          editable="true"
                          promptText="Enter name"
                          prefWidth="400"
                          prefHeight="50"
                          style="-fx-font-size: 22px;"/>

                <!-- Chakra‐count selector -->
                <Label text="Starting Chakra Natures:"
                       style="-fx-font-size: 24px;"/>
                <ComboBox fx:id="chakraCountBox"
                          prefWidth="250"
                          prefHeight="45"
                          style="-fx-font-size: 20px;"/>

                <!-- dynamic chakra‐nature dropdowns -->
                <VBox fx:id="chakraTypesContainer"
                      alignment="CENTER"
                      spacing="15"/>

                <!-- Jinchūriki radio buttons -->
                <Label text="Become a Jinchuriki?"
                       style="-fx-font-size: 24px;"/>
                <HBox spacing="30" alignment="CENTER">
                    <RadioButton fx:id="jinchYes"
                                 text="Yes"
                                 style="-fx-font-size: 20px;"/>
                    <RadioButton fx:id="jinchNo"
                                 text="No"
                                 style="-fx-font-size: 20px;"/>
                </HBox>

                <!-- Beast selector -->
                <ComboBox fx:id="jinchurikiBox"
                          promptText="Select Tailed Beast"
                          prefWidth="350"
                          prefHeight="45"
                          style="-fx-font-size: 20px;"/>

                <!-- Confirm / Back buttons -->
                <HBox spacing="40" alignment="CENTER">
                    <Button fx:id="confirmButton"
                            text="Confirm"
                            prefWidth="150"
                            prefHeight="60"
                            style="-fx-font-size: 20px;"/>
                    <Button fx:id="backButton"
                            text="Back"
                            prefWidth="150"
                            prefHeight="60"
                            style="-fx-font-size: 20px;"/>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>

</HBox>