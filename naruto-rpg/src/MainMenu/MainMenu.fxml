<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="MainMenu.MainMenuController"
            prefWidth="1600" prefHeight="900">

    <children>
        <ImageView fx:id="backgroundImage"
                   AnchorPane.topAnchor="0"
                   AnchorPane.bottomAnchor="0"
                   AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0"
                   preserveRatio="false"/>

        <Button fx:id="playButton"
                text="PLAY"
                prefWidth="200" prefHeight="70"
                AnchorPane.bottomAnchor="30"
                AnchorPane.rightAnchor="640"
                style="-fx-background-color: gold; -fx-font-size: 40px;"/>
    </children>
</AnchorPane>